[Unit]
Description=Spotflow observability daemon
# Ordering only: absent services are not pulled into the boot transaction.
After=systemd-journald.service syslog.service systemd-pstore.service

[Service]
Type=simple
User=@USER@
Group=@GROUP@
@JOURNAL_GROUP@
# Unprovisioned devices remain stopped rather than entering a restart loop.
ExecCondition=@SBINDIR@/spotflowd config-check --config @SYSCONFDIR@/spotflow/spotflowd.toml
ExecStart=@SBINDIR@/spotflowd run --config @SYSCONFDIR@/spotflow/spotflowd.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=spotflow
StateDirectoryMode=0750
RuntimeDirectory=spotflow
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@LOCALSTATEDIR@/lib/spotflow
@PSTORE_WRITE@

[Install]
WantedBy=multi-user.target
